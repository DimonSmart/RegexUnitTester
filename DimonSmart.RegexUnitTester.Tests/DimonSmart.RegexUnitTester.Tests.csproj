<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="Microsoft.Testing.Extensions.VSTestBridge" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DimonSmart.RegexUnitTester.Attributes\DimonSmart.RegexUnitTester.Attributes.csproj" />
    <ProjectReference Include="..\DimonSmart.RegexUnitTester.TestAdapter\DimonSmart.RegexUnitTester.TestAdapter.csproj" />
  </ItemGroup>

  <PropertyGroup>
	<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<IsTestProject>true</IsTestProject>
	<ParallelizeTestCollections>false</ParallelizeTestCollections>
	<EnableMSTestRunner Condition="'$(UseMtp)' == 'true'">true</EnableMSTestRunner>
	<TestingPlatformDotnetTestSupport Condition="'$(UseMtp)' == 'true'">true</TestingPlatformDotnetTestSupport>
	<OutputType Condition="'$(UseMtp)' == 'true'">Exe</OutputType>
  </PropertyGroup>

</Project>
